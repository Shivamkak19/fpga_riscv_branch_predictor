# lab4-format build artifacts (configure-generated; rebuild via `make`).
# Per the lab4 convention we don't commit these; only the source-checked
# autoconf scripts (configure, *.in) and the on-disk vmh outputs we want
# diffable need to live in git.
tests/build/Makefile
tests/build/config.*
tests/build/dep/
tests/build/obj/
tests/build/bin/
tests/build/dump/
tests/build/*.d

ubmark/build/Makefile
ubmark/build/config.*
ubmark/build/ubmark.mk
ubmark/build/ubmark-config.h
ubmark/build/dep/
ubmark/build/obj/
ubmark/build/bin/
ubmark/build/dump/
ubmark/build/*.a
ubmark/build/*.o
ubmark/build/*.d

# Top-level lab4 build dir (transient): Makefile is committed but the
# per-variant simv binary, vcd dumps, and *-long.out files are
# regenerated by `make` / `scripts/run_variants.sh`.
build/riscvlong-sim
build/riscvlong-randdelay-sim
build/riscvooo-sim
build/riscvooo-randdelay-sim
build/*.vcd
build/*.out
build/*-utst
build/template.sav

# Autotools detritus
tests/autom4te.cache/
ubmark/autom4te.cache/

# Yosys per-variant logs are large and contain absolute paths; keep only
# the aggregated yosys_summary.tsv.
results/*/yosys_stat.txt
results/*.log

# Vivado run dirs (deferred — kept for the eventual on-bench session)
fpga/runs/
*.jou
*.str
*.pb
*.dcp
*.bit
*.ltx
.Xil/
fpga/.Xil/
xsim.dir/
webtalk*.xml

# Don't ever commit secrets
secrets.txt
*.pem
*.key
.env
.envrc

# OS noise
.DS_Store
Thumbs.db

# Editor noise
.vscode/
.idea/
*.swp
*.swo

# Python
__pycache__/
*.pyc
